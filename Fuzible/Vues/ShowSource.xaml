<Window x:Class="Fuzible.ShowSource"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fuzible"
        xmlns:resx="clr-namespace:Fuzible.Languages"
        mc:Ignorable="d"
        Closing="MainWindow_Closing"
        Title="{x:Static resx:Languages.ss_lbl_title}" ResizeMode="CanResizeWithGrip" SizeToContent="Width" Background="White" WindowStartupLocation="CenterScreen" KeyUp="Window_KeyUp">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FuzibleSkin.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Viewbox Stretch="Uniform">

        <Grid Height="720" Width="820">
            <Canvas>
                <Button x:Name="btnLoadData" Style="{StaticResource FlatButton}" Content="{x:Static resx:Languages.ss_btn_clicktoload}"  Width="260" Height="25" Canvas.Left="360" Canvas.Top="10" Click="BtnLoadData_Click"/>
                <CheckBox x:Name="ckDataAnalyzer" Style="{StaticResource FlatCheckBox}" Height="25" Content="{x:Static resx:Languages.ss_ck_shs}" Canvas.Left="630" Canvas.Top="10" IsChecked="False" ToolTip="Data will be smartly analyzed. Results will be reported as a tooltip on each data column" Padding="2,0,0,0" Width="180" />
                <TextBox x:Name="tbMaxRowsPreview" Style="{StaticResource TextBoxFlatStyle}" Height="25" TextWrapping="Wrap" Text="1000"  Width="45" MaxLength="7" Canvas.Left="125" Canvas.Top="10" ToolTip="Maximum Rows Preview"/>
                <Label Content="{x:Static resx:Languages.ss_lbl_previewrows}"  Height="25" Width="110" Canvas.Left="10" Canvas.Top="10"/>
                <Button x:Name="btnCopyAsCSV" Style="{StaticResource FlatButton}" Content="{x:Static resx:Languages.ss_btn_exportascsv}"  Width="170" Height="25" Canvas.Left="620" Canvas.Top="680" Click="BtnCopyAsCSV_Click"/>
                <Button x:Name="btnCancelLoad" Style="{StaticResource FlatButton}" Content="{x:Static resx:Languages.ss_btn_cancelload}"  Width="160" Height="25" Canvas.Left="10" Canvas.Top="680" Click="BtnCancelLoad_Click"/>

            </Canvas>
            <TabControl x:Name="tcMenu" Style="{StaticResource FlatTabControl}" Margin="0,50,0,50">
                <TabItem Header="{x:Static resx:Languages.ss_mnu_source}">
                    <Canvas Margin="0,0,0,0">

                        <DataGrid x:Name="DsDataSource" CopyingRowClipboardContent="DataGrid_CopyingRowClipboardContent" ColumnHeaderStyle="{StaticResource HeaderStyle}" AutoGenerateColumns="False"  HeadersVisibility="Column" HorizontalAlignment="Left" Height="500" VerticalAlignment="Top" Width="790" Canvas.Left="10" Canvas.Top="90" IsReadOnly="True" Background="White" AlternatingRowBackground="LightYellow" RowBackground="White" FontSize="9" MouseRightButtonUp="DsDataSource_MouseRightButtonUp">
                            <DataGrid.Resources>
                                <Style TargetType="Label"/>
                            </DataGrid.Resources>
                        </DataGrid>
                        <Label x:Name="lbStatsSource" Content="{x:Static resx:Languages.ss_lbl_infodatasource}" Canvas.Top="5" Canvas.Left="10" Width="350" FontSize="9" Height="80" MouseRightButtonUp="LbStatsSource_MouseRightButtonUp"/>
                        <Label x:Name="lbPropertiesSource" Content="" Canvas.Top="5" Canvas.Left="365" Foreground="DarkOrange" Width="425" FontSize="9" Height="80" MouseRightButtonUp="LbStatsSource_MouseRightButtonUp"/>

                    </Canvas>
                </TabItem>
                <TabItem Header="{x:Static resx:Languages.ss_mnu_target}">
                    <Canvas>
                        <DataGrid x:Name="DsDataTarget" CopyingRowClipboardContent="DataGrid_CopyingRowClipboardContent" ColumnHeaderStyle="{StaticResource HeaderStyle}" AutoGenerateColumns="False" HeadersVisibility="Column" HorizontalAlignment="Left" Height="500" VerticalAlignment="Top" Width="790" Canvas.Left="10" Canvas.Top="90" IsReadOnly="True"  Background="White" AlternatingRowBackground="LightYellow" RowBackground="White" FontSize="9"/>
                        <Label x:Name="lbStatsTarget" Content="{x:Static resx:Languages.ss_lbl_infodatatarget}" Canvas.Top="5" Canvas.Left="10" Foreground="Red" Width="780" FontSize="9" Height="80"/>
                    </Canvas>
                </TabItem>
                <TabItem Header="{x:Static resx:Languages.ss_mnu_insert}">
                    <Canvas>
                        <DataGrid x:Name="DsDataSInsert" CopyingRowClipboardContent="DataGrid_CopyingRowClipboardContent" ColumnHeaderStyle="{StaticResource HeaderStyle}" AutoGenerateColumns="False"  HeadersVisibility="Column" HorizontalAlignment="Left" Height="500" VerticalAlignment="Top" Width="790" Canvas.Left="10" Canvas.Top="90" IsReadOnly="True" Background="White" AlternatingRowBackground="LightYellow" RowBackground="White" FontSize="9"/>
                        <Label x:Name="lbStatsSInsert" Content="{x:Static resx:Languages.ss_lbl_infodatainsert}" Canvas.Top="5" Canvas.Left="10" Foreground="Red" Width="780" FontSize="9" Height="80"/>
                    </Canvas>
                </TabItem>
                <TabItem Header="{x:Static resx:Languages.ss_mnu_update}">
                    <Canvas>
                        <DataGrid x:Name="DsDataSUpdate" CopyingRowClipboardContent="DataGrid_CopyingRowClipboardContent" ColumnHeaderStyle="{StaticResource HeaderStyle}" AutoGenerateColumns="False"  HeadersVisibility="Column" HorizontalAlignment="Left" Height="500" VerticalAlignment="Top" Width="790" Canvas.Left="10" Canvas.Top="90" IsReadOnly="True" Background="White" AlternatingRowBackground="LightYellow" RowBackground="White" FontSize="9"/>
                        <Label x:Name="lbStatsSUpdate" Content="{x:Static resx:Languages.ss_lbl_infodataupdate}" Canvas.Top="5" Canvas.Left="10" Foreground="Red" Width="780" FontSize="9" Height="80"/>
                    </Canvas>
                </TabItem>
                <TabItem Header="{x:Static resx:Languages.ss_mnu_delete}">
                    <Canvas>
                        <DataGrid x:Name="DsDataSDelete" CopyingRowClipboardContent="DataGrid_CopyingRowClipboardContent" ColumnHeaderStyle="{StaticResource HeaderStyle}" AutoGenerateColumns="False"  HeadersVisibility="Column" HorizontalAlignment="Left" Height="500" VerticalAlignment="Top" Width="790" Canvas.Left="10" Canvas.Top="90" IsReadOnly="True" Background="White" AlternatingRowBackground="LightYellow" RowBackground="White" FontSize="9"/>
                        <Label x:Name="lbStatsSDelete" Content="{x:Static resx:Languages.ss_lbl_infodatadelete}" Canvas.Top="5" Canvas.Left="10" Foreground="Red" Width="780" FontSize="9" Height="80"/>
                    </Canvas>
                </TabItem>
            </TabControl>
        </Grid>
    </Viewbox>
</Window>
