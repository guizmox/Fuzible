<Window x:Class="Fuzible.LogConsole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fuzible"
        xmlns:resx="clr-namespace:Fuzible.Languages"
        mc:Ignorable="d"
        Title="Log Console" Height="450" Width="800"
        Loaded="OnLogLoad">
    <Grid>
        <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Visible" Margin="0" Background="Black">
            <TextBlock Name="OutputBlock" Foreground="White" FontFamily="Consolas" Padding="5" TextWrapping="NoWrap" FontSize="11"/>
        </ScrollViewer>
    </Grid>
</Window>
