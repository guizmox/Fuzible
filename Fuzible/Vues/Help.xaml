<Window x:Name="SHSHelp" x:Class="Fuzible.Help"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fuzible"
        xmlns:resx="clr-namespace:Fuzible.Languages"
        mc:Ignorable="d"
        Closed="SHSHelp_Closed"
        Loaded="SHSHelp_Loaded"
        KeyDown="Help_KeyDown"
      Title="{x:Static resx:Languages.hlp_title01}" Height="605" Width="840" ResizeMode="NoResize" Background="White" WindowStartupLocation="Manual" Left="0">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FuzibleSkin.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Canvas>
            <Button x:Name="btnClose" Style="{StaticResource FlatButton}" Content="{x:Static resx:Languages.hlp_btn_close}" Height="25" Click="BtnClose_Click" Canvas.Left="753" Canvas.Top="540" Width="60"/>
            <Button x:Name="btnSave" Visibility="Hidden" Style="{StaticResource FlatButton}" Content="! UPDATE !" Height="25" Click="BtnSave_Click" Canvas.Left="653" Canvas.Top="540" Width="95" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <DockPanel>
                <!-- Barre d'outils -->
                <ToolBar Name="tbToolBar" Visibility="Hidden" DockPanel.Dock="Top" >
                    <Button Content="B" Click="ToggleBold"></Button>
                    <Button Content="I" Click="ToggleItalic"></Button>
                    <Button Content="U" Click="ToggleUnderline"></Button>
                    <Button Command="EditingCommands.ToggleBullets" Click="ToggleBullets">•</Button>
                    <Button Command="EditingCommands.IncreaseFontSize" Click="IncreaseFontSize">A+</Button>
                    <Button Command="EditingCommands.DecreaseFontSize" Click="DecreaseFontSize">A-</Button>
                    <Button Click="ChangeFontColor">Couleur</Button>
                </ToolBar>
                <GroupBox Name="gbTBHelp" Width="800" Foreground="DarkOrange" BorderBrush="DarkOrange" Header="{x:Static resx:Languages.hlp_title02}"  Canvas.Left="5" Canvas.Top="5">
                    <RichTextBox x:Name="tbHelp" BorderThickness="0" VerticalScrollBarVisibility="Visible" AcceptsReturn="True" AcceptsTab="True" Background="White" Foreground="Black" MouseDoubleClick="TbHelp_MouseDoubleClick" Height="490" IsReadOnly="True"/>
                </GroupBox>
            </DockPanel>

            <GroupBox Name="gbWBHelp" Foreground="DarkOrange" BorderBrush="DarkOrange" Header="{x:Static resx:Languages.hlp_title02}"  Canvas.Left="5" Canvas.Top="26" HorizontalAlignment="Center" Height="492" VerticalAlignment="Top">
                <WebBrowser x:Name="wbHelp" Height="490" Width="800" Canvas.Left="5" Canvas.Top="5"/>
            </GroupBox>
        </Canvas>
    </Grid>
</Window>
