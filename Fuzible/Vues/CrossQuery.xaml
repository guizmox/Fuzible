<Window x:Class="Fuzible.CrossQuery"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Fuzible"
      xmlns:resx="clr-namespace:Fuzible.Languages"
      mc:Ignorable="d"
        Title="Cross Queries" Height="310" Width="520" ResizeMode="NoResize" Background="White" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FuzibleSkin.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Canvas>
            <Label x:Name="lbTechnicalInfo" Content="Same column names between both sources will be used as the Primary Key :&#x0a;        SELECT id_client as mylink, li_client as client_name FROM mytable&#x0a;        [--[2]] SELECT client_id as mylink, creation_date as client_creation FROM myfile.csv&#x0a;&#x0a;        -> The column called 'mylink' will become the primary key to link both sources&#x0a;             You can use up to 5 key columns to perform join operation"  Width="490" Height="110" Canvas.Left="10" Canvas.Top="10" Foreground="DarkOrange"/>
            <Label x:Name="lbJoinType" HorizontalContentAlignment="Center" Content="{x:Static resx:Languages.cq_lbl_jointype}" Width="80" Height="25" Canvas.Left="215" Canvas.Top="120"/>
            <ComboBox x:Name="cbFirstConnection" Style="{StaticResource ComboBoxFlatStyle}" IsEnabled="False" SelectedValuePath="Tag"  Width="200" Height="25" Canvas.Left="10" Canvas.Top="150" />
            <TextBox x:Name="tbOutputA" Style="{StaticResource TextBoxFlatStyle}" Height="25" TextWrapping="Wrap" Width="200" Canvas.Top="180" Canvas.Left="10" MaxLines="1" MaxLength="32"/>
            <Label HorizontalContentAlignment="Left" Content="{x:Static resx:Languages.cq_lbl_firstconnection}"  Width="200" Height="25" Canvas.Left="10" Canvas.Top="120"/>
            <ComboBox x:Name="cbSecondConnection" Style="{StaticResource ComboBoxFlatStyle}" SelectedValuePath="Tag"  Width="200" Height="25" Canvas.Left="300" Canvas.Top="150" />
            <TextBox x:Name="tbOutputB" Style="{StaticResource TextBoxFlatStyle}" Height="25" TextWrapping="Wrap" Width="200" Canvas.Top="180" Canvas.Left="300" MaxLines="1" MaxLength="32"/>
            <Label HorizontalContentAlignment="Right" Content="{x:Static resx:Languages.cq_lbl_secondconnection}"  Width="200" Height="25" Canvas.Left="300" Canvas.Top="120"/>
            <Label x:Name="lbCrossQueryFilter" HorizontalContentAlignment="Left" Content="{x:Static resx:Languages.cq_lbl_queryfilter}"  Width="240" Height="25" Canvas.Left="10" Canvas.Top="210"/>
            <TextBox x:Name="tbCrossQueryFilter" Style="{StaticResource TextBoxFlatStyle}" Height="25" TextWrapping="Wrap" Width="250" Canvas.Top="210" Canvas.Left="250" MaxLines="1" MaxLength="64"/>
            <Button x:Name="btnCancel" Style="{StaticResource FlatButton}" Content="{x:Static resx:Languages.cq_btn_accept}"  Width="70" Click="BtnAccept_Click" Height="25" Canvas.Left="220" Canvas.Top="245"/>
            <ComboBox x:Name="cbJoinType" Style="{StaticResource ComboBoxFlatStyle}" SelectedValuePath="Tag"  Width="60" Height="25" Canvas.Left="225" Canvas.Top="150">
                <ComboBoxItem Content="INNER" HorizontalAlignment="Left" Width="50" Tag="INNER"/>
                <ComboBoxItem Content="LEFT" HorizontalAlignment="Left" Width="50" Tag="LEFT"/>
                <ComboBoxItem Content="RIGHT" HorizontalAlignment="Left" Width="50" Tag="RIGHT"/>
                <ComboBoxItem Content="OUTER" HorizontalAlignment="Left" Width="50" Tag="OUTER"/>
            </ComboBox>
        </Canvas>
    </Grid>

</Window>
