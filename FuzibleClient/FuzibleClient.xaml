<Window x:Name="FuzibleClient" x:Class="FuzibleClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FuzibleClient"
        xmlns:resx="clr-namespace:FuzibleClient.Languages"
        mc:Ignorable="d"
        Title="{x:Static resx:Languages.fc_lbl_title}" ResizeMode="CanResizeWithGrip" SizeToContent="Width">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FuzibleSkin.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
        <Grid Height="420" Width="600">
            <Canvas Margin="0,0,0,0">
                <ComboBox x:Name="cbINISection" Style="{StaticResource ComboBoxFlatStyle}" SelectedValuePath="Tag" SelectionChanged="CbINISection_SelectionChanged" Canvas.Left="107" Canvas.Top="30" Width="300" Height="25" />
                <Button x:Name="btnExecuteTask" Style="{StaticResource FlatButton}" Content="{x:Static resx:Languages.fc_btn_request}" Click="BtnExecuteTask_Click" IsEnabled="False" Width="175" Height="25" Canvas.Left="420" Canvas.Top="30"/>
                <Label Content="{x:Static resx:Languages.fc_btn_dynparams}" Height="25" Width="140" Canvas.Top="70" Canvas.Left="5"/>
                <ScrollViewer Style="{StaticResource FavsScrollViewer}" VerticalScrollBarVisibility="Visible" Height="220" Width="590" Canvas.Left="5" Canvas.Top="135">
                    <Border BorderBrush="Gray" BorderThickness="1">
                        <TextBlock x:Name="tbConsole" Foreground="DarkBlue" Padding="2,2,2,2" TextWrapping="NoWrap" FontSize="10">Informations</TextBlock>
                    </Border>
                </ScrollViewer>
                <RichTextBox x:Name="tbQueryVariableParameters" Foreground="#FF052872" AcceptsReturn="False" AcceptsTab="False" Height="25" Width="445" VerticalContentAlignment="Center" Canvas.Left="149" Canvas.Top="70" KeyUp="TbQueryVariableParameters_KeyUp" FontStyle="Italic" FontSize="10"/>
                <Label Content="{x:Static resx:Languages.fc_lbl_listofjobs}" Height="25" Width="100" Canvas.Top="30" Canvas.Left="5"/>
                <Button x:Name="btnVoirRequetes" Style="{StaticResource FlatButton}" Content="{x:Static resx:Languages.fc_btn_viewqueries}" Width="140" Click="BtnVoirRequetes_Click" Height="25" Canvas.Left="335" Canvas.Top="357" IsEnabled="False"/>
                <Label x:Name="lbAboutApp" Content=""  Height="24" Width="590" Canvas.Left="5" Canvas.Top="390" FontSize="9"/>
                <Button x:Name="btnCheckStatus" Style="{StaticResource FlatButton}" Content="{x:Static resx:Languages.fc_btn_checkstatus}" Width="110" Click="BtnCheckStatus_Click" Height="25" Canvas.Left="485" Canvas.Top="357" IsEnabled="False"/>
                <Label Content="{x:Static resx:Languages.fc_lbl_scheduledexec}" Height="25" Width="140" Canvas.Top="100" Canvas.Left="5"/>
                <DatePicker x:Name="dtRequestedExecution" Canvas.Left="152" Canvas.Top="100" Width="180" SelectedDateFormat="Short"/>
                <TextBox x:Name="tbRequestedExecutionHour" Style="{StaticResource TextBoxFlatStyle}" Height="25" TextWrapping="Wrap"  Width="49" Canvas.Left="340" Canvas.Top="100" MaxLines="1" MaxLength="2"/>
                <Label Content="H" Height="25" Width="26" Canvas.Top="102" Canvas.Left="393"/>
            </Canvas>

        </Grid>
    </Viewbox>
</Window>
