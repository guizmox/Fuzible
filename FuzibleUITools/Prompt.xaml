<Window x:Name="wPrompt" x:Class="FuzibleUITools.Prompt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FuzibleUITools"
             mc:Ignorable="d" 
             ResizeMode="NoResize" BorderThickness="2" WindowStyle="None" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" KeyDown="This_KeyDown">
    
    <Grid Width="300" Height="80" >
        <Canvas>
            <TextBox x:Name="lbText" BorderThickness="0" Width="290" Canvas.Left="5" Canvas.Top="10" Height="35" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="btnOK" Content="OK" Canvas.Left="275" Canvas.Top="50" Click="BtnOK_Click"/>
        </Canvas>
        <Canvas x:Name="CvPrompt" Margin="10,50,30,30">
        </Canvas>
    </Grid>
</Window>
