<Window x:Name="wComboBoxPrompt" x:Class="FuzibleUITools.ComboBoxPrompt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FuzibleUITools"
             mc:Ignorable="d" 
             ResizeMode="NoResize" BorderThickness="2" WindowStyle="None" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" KeyDown="This_KeyDown" Width="280">


    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FuzibleSkin.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Width="280" Height="80" >
        <Canvas>
            <ComboBox x:Name="cbJobFamily" SelectedIndex="-1" Style="{StaticResource ComboBoxFlatStyle}" SelectedValuePath="Tag"  Width="155" Height="25" Canvas.Left="115" Canvas.Top="10" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBox x:Name="tbText" BorderThickness="1" Width="130" Canvas.Left="115" Canvas.Top="45" Height="25" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Button x:Name="btnOK" Content="OK" Canvas.Left="250" Canvas.Top="45" Click="BtnOK_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Height="25"/>
            <Label Name="lbCb" Content="" Canvas.Left="10" Canvas.Top="13" HorizontalAlignment="Center" Height="25" VerticalAlignment="Top" Width="105"/>
            <Label Name="lbTb" Content="" Canvas.Left="10" Canvas.Top="46" HorizontalAlignment="Center" Height="25" VerticalAlignment="Top" Width="105"/>
        </Canvas>
        <Canvas x:Name="CvComboBoxPrompt" Margin="10,50,30,30">
        </Canvas>
    </Grid>
</Window>
