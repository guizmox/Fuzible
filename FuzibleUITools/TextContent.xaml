<Window x:Name="wTextContent" x:Class="FuzibleUITools.TextContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FuzibleUITools"
             mc:Ignorable="d" 
             ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" KeyDown="This_KeyDown" WindowStyle="None" BorderThickness="1,1,1,1">
    <Grid Width="400" Height="350" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="273*"/>
            <ColumnDefinition Width="127*"/>
        </Grid.ColumnDefinitions>
        <Canvas Grid.ColumnSpan="2">
            <TextBlock x:Name="lbInfo" Width="385" Canvas.Left="5" Canvas.Top="5" Height="65" TextWrapping="Wrap" IsEnabled="False"/>
            <RichTextBox x:Name="lbText" Block.LineHeight="2" BorderThickness="1" Width="385" Canvas.Left="5" Canvas.Top="75" Height="240" BorderBrush="DarkOrange" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
            <Button x:Name="btnOK" Content="OK" Canvas.Left="370" Canvas.Top="320" Click="BtnOK_Click"/>
        </Canvas>
    </Grid>
</Window>
